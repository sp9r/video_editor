{
  "name": "spectra-video-studio",
  "version": "0.1.0",
  "private": true,
  "description": "A portable, non-linear desktop video editor for everyday YouTube production.",
  "main": "./out/main/index.js",
  "bin": {
    "video-editor": "scripts/video-editor.mjs"
  },
  "type": "module",
  "author": "Spectra Video Studio contributors",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node node_modules/electron/install.js && electron-builder install-app-deps",
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "smoke:electron": "node scripts/electron-startup-smoke.mjs",
    "smoke:accurate-preview": "npm run build && node scripts/accurate-preview-smoke.mjs",
    "subtitle:geometry": "npm run build && node scripts/subtitle-geometry-smoke.mjs",
    "subtitle:parity": "npm run build && node scripts/subtitle-parity-harness.mjs",
    "preview": "npm run build && electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "check": "npm run typecheck && npm run test",
    "dist": "npm run check && npm run build && electron-builder",
    "dist:win": "npm run check && npm run build && electron-builder --win nsis portable --x64",
    "dist:mac": "npm run check && npm run build && electron-builder --mac dmg zip --x64 --arm64",
    "dist:linux": "npm run check && npm run build && electron-builder --linux AppImage deb --x64",
    "fixture": "node scripts/create-test-fixture.mjs"
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "latest",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "jp.spectra.video-studio",
    "productName": "Spectra Video Studio",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE",
      "NOTICE.md"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "${productName}-${version}-${os}-${arch}-setup.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-${os}-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo"
    }
  }
}
